generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UploadKind {
  IMAGE
  VIDEO
  TEXT
  FILE
}

enum UploadState {
  READY
  DELETING
  DELETE_FAILED
}

enum DirectUploadState {
  CREATING
  UPLOADING
  VERIFYING
  PUBLISHED
  ABORTING
  ABORTED
  FAILED
}

enum VariantKind {
  GIF
}

enum VariantState {
  READY
  DELETING
  DELETE_FAILED
}

enum ContentDisposition {
  INLINE
  ATTACHMENT
}

enum SeedynRole {
  MEMBER
  ADMIN
}

enum StorageReservationKind {
  ORIGINAL
  GIF
}

enum UploadOrigin {
  LEGACY_UNKNOWN
  BROWSER
  HTTP
  SHAREX
  S3
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  issuer                   String?
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                   String                @id @default(cuid())
  name                 String?
  email                String?               @unique
  emailVerified        DateTime?
  image                String?
  identityIssuer       String?
  identitySubject      String?
  appRole              SeedynRole            @default(MEMBER)
  storageLimitBytes    BigInt?
  storageUsedBytes     BigInt                @default(0)
  storageReservedBytes BigInt                @default(0)
  defaultMediaDomain   String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  accounts             Account[]
  sessions             Session[]
  apiKeys              ApiKey[]
  cliAuthRequests      CliAuthRequest[]
  uploads              Upload[]
  directUploadSessions DirectUploadSession[]
  storageReservations  StorageReservation[]
  auditEvents          AuditEvent[]

  @@unique([identityIssuer, identitySubject])
  @@index([createdAt, id])
}

model AuditEvent {
  id          String   @id @default(uuid())
  occurredAt  DateTime @default(now())
  category    String
  action      String
  outcome     String
  actorType   String
  userId      String?
  actorLabel  String?
  apiKeyId    String?
  requestId   String?
  method      String?
  route       String?
  statusCode  Int?
  targetType  String?
  targetId    String?
  metadata    Json?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([occurredAt(sort: Desc), id(sort: Desc)])
  @@index([userId, occurredAt(sort: Desc)])
  @@index([category, occurredAt(sort: Desc)])
  @@index([action, occurredAt(sort: Desc)])
  @@index([outcome, occurredAt(sort: Desc)])
}

model StorageReservation {
  id         String                 @id
  userId     String
  storageKey String                 @unique
  byteSize   BigInt
  kind       StorageReservationKind
  expiresAt  DateTime
  createdAt  DateTime               @default(now())
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ApiKey {
  id                String    @id
  userId            String
  name              String
  slug              String
  clientLabel       String?
  mediaDomain       String?
  prefix            String
  secretHash        Bytes     @unique
  scopes            String[]
  s3AccessKeyId     String?   @unique
  s3PublicNamespace String?   @unique
  s3EnabledAt       DateTime?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime?
  expiresAt         DateTime?
  revokedAt         DateTime?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cliAuthRequests   CliAuthRequest[]

  @@unique([userId, slug])
  @@index([userId, revokedAt, createdAt(sort: Desc)])
}

model CliAuthRequest {
  id              String   @id
  pollSecretHash  Bytes    @unique
  publicKey       String
  encryptedApiKey Bytes?
  userId          String?
  apiKeyId        String?
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  approvedAt      DateTime?
  claimedAt       DateTime?
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey           ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, createdAt(sort: Desc)])
}

model Upload {
  id                        String               @id
  userId                    String
  publicSlug                String               @unique
  kind                      UploadKind
  state                     UploadState          @default(READY)
  originalName              String
  textLanguage              String?
  passwordHash              String?
  passwordVersion           Int                  @default(0)
  origin                    UploadOrigin         @default(LEGACY_UNKNOWN)
  apiKeyIdSnapshot          String?
  apiKeyNameSnapshot        String?
  apiKeySlugSnapshot        String?
  clientLabelSnapshot       String?
  mediaOrigin               String?
  s3ObjectKey               String?
  s3PublicNamespaceSnapshot String?
  extension                 String
  contentType               String
  disposition               ContentDisposition
  byteSize                  BigInt
  sha256                    Bytes
  storageKey                String               @unique
  width                     Int?
  height                    Int?
  durationMs                Int?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  deleteErrorCode           String?
  deleteErrorAt             DateTime?
  user                      User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  variants                  UploadVariant[]
  directUploadSession       DirectUploadSession? @relation("PublishedDirectUpload")

  @@unique([s3PublicNamespaceSnapshot, s3ObjectKey])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, kind, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([kind, createdAt(sort: Desc)])
  @@index([origin, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, apiKeyIdSnapshot, createdAt(sort: Desc), id(sort: Desc)])
  @@index([state, updatedAt])
}

model DirectUploadSession {
  id                 String             @id
  userId             String
  uploadId           String             @unique
  publishedUploadId  String?            @unique
  state              DirectUploadState  @default(CREATING)
  storageKey         String             @unique
  s3UploadId         String?
  declaredBytes      BigInt
  declaredSha256     Bytes
  sniffPrefix        Bytes
  partSize           Int
  partCount          Int
  kind               UploadKind
  extension          String
  contentType        String
  disposition        ContentDisposition
  originalName       String
  publicSlug         String
  mediaOrigin        String
  observedParts      Json?
  storageCompletedAt DateTime?
  leaseOwner         String?
  leaseExpiresAt     DateTime?
  expiresAt          DateTime
  hardExpiresAt      DateTime
  failureCode        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishedUpload    Upload?            @relation("PublishedDirectUpload", fields: [publishedUploadId], references: [id], onDelete: Cascade)

  @@index([state, expiresAt])
  @@index([state, leaseExpiresAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([publicSlug, state])
}

model UploadVariant {
  id              String             @id
  uploadId        String
  publicSlug      String             @unique
  kind            VariantKind
  state           VariantState       @default(READY)
  extension       String
  contentType     String
  disposition     ContentDisposition @default(INLINE)
  byteSize        BigInt
  sha256          Bytes
  storageKey      String             @unique
  width           Int?
  height          Int?
  durationMs      Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deleteErrorCode String?
  deleteErrorAt   DateTime?
  upload          Upload             @relation(fields: [uploadId], references: [id], onDelete: Restrict)

  @@unique([uploadId, kind])
  @@index([state, updatedAt])
}
