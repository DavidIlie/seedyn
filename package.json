{
  "name": "seedyn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "prisma generate",
    "db:migrate": "NODE_ENV=${NODE_ENV:-development} node scripts/run-command-with-next-env.mjs prisma migrate deploy",
    "db:migrate:dev": "NODE_ENV=${NODE_ENV:-development} node scripts/run-command-with-next-env.mjs prisma migrate dev",
    "db:seed": "NODE_ENV=${NODE_ENV:-development} NODE_OPTIONS=--conditions=react-server tsx scripts/run-with-next-env.ts prisma/seed.ts",
    "db:studio": "NODE_ENV=${NODE_ENV:-development} node scripts/run-command-with-next-env.mjs prisma studio",
    "dev": "node scripts/dev.mjs",
    "docs:generate": "fumadocs-mdx",
    "format:check": "prettier --check . --cache",
    "format:write": "prettier --write . --cache",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives .",
    "lint:fix": "oxlint --type-aware --fix .",
    "postinstall": "prisma generate && node scripts/copy-ffmpeg-assets.mjs",
    "preview": "pnpm build && pnpm start",
    "start": "NODE_ENV=production node scripts/start-standalone.mjs",
    "start:standalone": "NODE_ENV=production node scripts/start-standalone.mjs",
    "storage:check": "NODE_ENV=${NODE_ENV:-development} NODE_OPTIONS=--conditions=react-server tsx scripts/run-with-next-env.ts scripts/reconcile-storage.ts",
    "storage:setup": "NODE_ENV=development NODE_OPTIONS=--conditions=react-server tsx scripts/run-with-next-env.ts scripts/ensure-dev-storage.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:production": "E2E_PRODUCTION=true SEEDYN_BUILD_INSTANT_TESTING=true PORT=3101 APP_URL=http://seedyn.localhost:3101 CDN_URL=http://i.localhost:3101 APP_HOSTS=seedyn.localhost,localhost MEDIA_HOSTS=i.localhost AUTH_SECRET=seedyn-e2e-production-auth-secret AUTH_DAVIDAPPS_ID=seedyn-e2e-client AUTH_DAVIDAPPS_SECRET=seedyn-e2e-client-secret SEEDYN_DEV_AUTH=false TRUSTED_PROXY_HOPS=1 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "NODE_ENV=development NODE_OPTIONS=--conditions=react-server tsx scripts/run-with-next-env.ts scripts/integration-smoke.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@next/env": "16.3.0",
    "@prisma/client": "6.19.3",
    "@t3-oss/env-nextjs": "0.13.10",
    "busboy": "1.6.0",
    "clsx": "2.1.1",
    "file-type": "22.0.2",
    "fumadocs-core": "16.14.4",
    "fumadocs-mdx": "15.2.3",
    "fumadocs-ui": "16.14.4",
    "gifenc": "1.0.3",
    "ioredis": "6.0.0",
    "lucide-react": "0.545.0",
    "minio": "8.0.7",
    "next": "16.3.0",
    "next-auth": "5.0.0-beta.32",
    "prisma": "6.19.3",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sharp": "0.35.3",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@next/playwright": "16.3.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.1.14",
    "@types/busboy": "1.5.4",
    "@types/mdx": "2.0.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/coverage-v8": "4.1.10",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.7.1",
    "tailwindcss": "4.1.14",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "undici": "8.10.0",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.0",
      "defu": "6.1.5",
      "lodash": "4.18.0"
    }
  }
}
