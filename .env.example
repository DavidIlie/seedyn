AUTH_SECRET=""
S3_MASTER_SECRET=""
AUTH_DAVIDAPPS_ID="N3HqSugmik9n4eSjXybKFybxlyWfKn3K"
AUTH_DAVIDAPPS_SECRET=""

DATABASE_URL="postgresql://seedyn:change-me@postgres.example.internal:5432/seedyn"
REDIS_URL="redis://redis.example.internal:6379"

APP_URL="https://seedyn.dave.tips"
CDN_URL="https://i.dave.tips"
MEDIA_DOMAINS="dave=https://i.dave.tips,gurt=https://i.gurt.ing"
APP_HOSTS="seedyn.dave.tips"
# Deprecated compatibility input. When MEDIA_DOMAINS is present, every host
# listed here must also be represented by a catalog origin.
MEDIA_HOSTS="i.dave.tips"
# Kubernetes Downward API value used only to authenticate direct pod probes.
POD_IP=""
TRUSTED_PROXY_HOPS="1"

# Controlled preview/CI builds only. Never enable on the public deployment.
SEEDYN_BUILD_INSTANT_TESTING="false"

MINIO_URL="cdn.davidapps.dev"
MINIO_PORT="443"
MINIO_SECURE="true"
# Browser-reachable S3 origin used only in short-lived presigned part URLs.
MINIO_PUBLIC_URL="https://cdn.davidapps.dev"
MINIO_REGION="us-east-1"
MINIO_KEY_ID=""
MINIO_PASSWORD=""
MINIO_BUCKET="seedyn"
DIRECT_UPLOAD_MAX_BYTES="2147483648"
# proxy streams each 16 MiB part through Seedyn; presigned requires bucket CORS.
DIRECT_UPLOAD_TRANSPORT="proxy"

# Local-only session provider. Production refuses to start with this enabled.
SEEDYN_DEV_AUTH="false"
SEEDYN_DEV_AUTH_EMAIL="david@davidilie.com"
